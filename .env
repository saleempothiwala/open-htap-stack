# Cassandra resources
CASSANDRA_MAX_HEAP_SIZE=2G
CASSANDRA_MEM_LIMIT=4g

# Host ports
JEFF_SQL_PORT=9040

# Data Ingress
DEMO_TOPIC=demo-events
DEMO_EVENTS_PER_SEC=5000
DEMO_PAYLOAD_BYTES=256
DEMO_GROUP_ID=demo-cassandra-sink
DEMO_KEYSPACE=demo
DEMO_TABLE=events
DEMO_BATCH_SIZE=200
DEMO_LOG_EVERY=10000

# Backend
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
PRESTO_HOST=localhost
PRESTO_PORT=8088
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=4000
